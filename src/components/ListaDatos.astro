---
/**
 * Lista de datos con su fuente. Si todos vienen del mismo documento, la fuente
 * va una sola vez al final (con todas sus páginas). Si vienen de documentos
 * distintos, se agrupan por documento («Según la Guía digestiva, págs. 5 y 13:»)
 * en el orden en que aparecen.
 */
import Fuente from './Fuente.astro';
import { parrafos } from '../lib/texto';
import { textoRefs } from '../lib/fuentes';

interface Item {
  texto: string;
  de: string[];
}
interface Props {
  items: Item[];
  /** Mostrar como párrafos aunque haya varios ítems. */
  comoTexto?: boolean;
}
const { items, comoTexto = false } = Astro.props;

const grupos: { docs: string; clave: string; refs: string[]; items: Item[] }[] = [];
const documentos = (refs: string[]) => [...new Set(refs.map((r) => r.split('/')[0]))].join('+');
for (const i of items) {
  const docs = documentos(i.de);
  const g = grupos.find((x) => x.docs === docs);
  if (g) {
    g.items.push(i);
    g.refs.push(...i.de.filter((r) => !g.refs.includes(r)));
  } else grupos.push({ docs, clave: '', refs: [...i.de], items: [i] });
}
for (const g of grupos) g.clave = textoRefs(g.refs);
const unaFuente = grupos.length <= 1;
const lista = (its: Item[]) => !comoTexto && its.length > 1;
---
{
  unaFuente ? (
    <>
      {lista(items) ? (
        <ul class="lista-datos">
          {items.map((i) => (
            <li set:html={parrafos(i.texto).join(' ')} />
          ))}
        </ul>
      ) : (
        items.map((i) => (
          <div class="parrafos">
            {parrafos(i.texto).map((p) => (
              <p set:html={p} />
            ))}
          </div>
        ))
      )}
      <Fuente refs={items.flatMap((i) => i.de)} />
    </>
  ) : (
    grupos.map((g) => (
      <div class="grupo-fuente">
        <p class="grupo-fuente__rotulo">Según {g.clave.replace(/^(Guía|Diapositivas|Taller)/, (m) => (m === 'Guía' ? 'la Guía' : m === 'Taller' ? 'el taller' : 'las diapositivas'))}:</p>
        {lista(g.items) ? (
          <ul class="lista-datos">
            {g.items.map((i) => (
              <li set:html={parrafos(i.texto).join(' ')} />
            ))}
          </ul>
        ) : (
          g.items.map((i) => (
            <div class="parrafos">
              {parrafos(i.texto).map((p) => (
                <p set:html={p} />
              ))}
            </div>
          ))
        )}
      </div>
    ))
  )
}
