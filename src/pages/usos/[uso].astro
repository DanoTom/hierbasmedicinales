---
import Base from '../../layouts/Base.astro';
import Encabezado from '../../components/Encabezado.astro';
import TarjetaPlanta from '../../components/TarjetaPlanta.astro';
import Icono from '../../components/Icono.astro';
import Aviso from '../../components/Aviso.astro';
import { datos, plantasDeUso, recetasDeUso, GRUPOS_USO, type Uso } from '../../lib/datos';
import { textoRefs } from '../../lib/fuentes';
import { enLinea } from '../../lib/texto';

export async function getStaticPaths() {
  const { usos } = await datos();
  return usos.map((uso) => ({ params: { uso: uso.id }, props: { uso } }));
}
interface Props {
  uso: Uso;
}
const { uso } = Astro.props;
const plantas = await plantasDeUso(uso.id);
const recetas = await recetasDeUso(uso.id);
const conPrecauciones = plantas.filter((p) => p.data.alertas.length).length;
---
<Base titulo={uso.data.nombre} descripcion={`Plantas y recetas para ${uso.data.nombre.toLowerCase()}.`}>
  <a class="volver" href="/usos/"><Icono nombre="izquierda" />Todos los usos</a>
  <Encabezado antetitulo={GRUPOS_USO[uso.data.grupo]} titulo={uso.data.nombre} bajada={uso.data.descripcion} />

  {
    uso.data.avisos.map((a) => (
      <aside class:list={['recuadro', a.tipo === 'urgencia' ? 'recuadro--urgencia' : 'recuadro--nota']} style="margin-top: 0">
        {a.titulo && (
          <h2 class="recuadro__titulo">
            {a.tipo === 'urgencia' && <Icono nombre="atencion" />}
            {a.titulo}
          </h2>
        )}
        <p set:html={enLinea(a.texto)} />
        <p class="fuente">
          {a.enlace && (
            <>
              Ver <a href={a.enlace.href}>{a.enlace.texto}</a>.{' '}
            </>
          )}
          <span class="fuente__rotulo">Fuente: </span>
          {textoRefs(a.de)}.
        </p>
      </aside>
    ))
  }

  <section class="seccion" aria-labelledby="t-plantas" style="margin-top: var(--e-5)">
    <h2 id="t-plantas">{plantas.length === 1 ? '1 planta' : `${plantas.length} plantas y hongos`}</h2>
    {
      conPrecauciones > 0 && (
        <p>
          <Icono nombre="atencion" /> Antes de elegir, abrí la ficha y leé las precauciones: {conPrecauciones === plantas.length ? 'todas tienen' : `${conPrecauciones} de ${plantas.length} tienen`} alguna.
        </p>
      )
    }
    <ul class="plantas">
      {
        plantas.map((p) => (
          <li>
            <TarjetaPlanta planta={p} encabezado="h3" />
          </li>
        ))
      }
    </ul>
  </section>

  {
    recetas.length > 0 && (
      <section class="seccion" aria-labelledby="t-recetas">
        <h2 id="t-recetas">Recetas</h2>
        <ul class="grilla">
          {recetas.map((r) => (
            <li>
              <a class="tarjeta" href={`/recetas/${r.id}/`}>
                <span class="tarjeta__titulo">{r.data.nombre}</span>
                {r.data.bajada && <span class="tarjeta__texto">{r.data.bajada}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="seccion">
    <Aviso />
  </section>
</Base>
